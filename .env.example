# ---- Aitsev backend settings (copy to .env and fill in) ----

# Ollama Cloud key from https://ollama.com/settings/keys
OLLAMA_API_KEY=

# API keys for clients, as name:key pairs (keys 16+ characters). Each name owns its tasks.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
AITSEV_API_KEYS=suppu:replace-with-a-long-random-key

AITSEV_ENVIRONMENT=development
AITSEV_LOG_LEVEL=INFO

# SQLite for quick local runs; docker compose overrides this with PostgreSQL.
AITSEV_DATABASE_URL=sqlite+aiosqlite:///./aitsev.db

# Encrypts stored connection credentials (phase 3). Required outside development.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
AITSEV_SECRET_KEY=

# Allow connections to localhost/private IPs. Default: allowed only in development.
# AITSEV_ALLOW_PRIVATE_NETWORKS=false

# docker = isolated containers (default, required outside development)
# local  = plain subprocess, development only, NOT isolated
AITSEV_SANDBOX_MODE=docker
AITSEV_SANDBOX_IMAGE=python:3.12-slim
AITSEV_SANDBOX_TIMEOUT_SECONDS=600

# Model roles as provider/model. Check the exact names with GET /v1/models.
AITSEV_PLANNER_MODEL=ollama-cloud/gpt-oss:120b
AITSEV_GENERATOR_MODELS=ollama-cloud/kimi-k2.6,ollama-cloud/deepseek-v4-flash,ollama-cloud/glm-5
AITSEV_REVIEWER_MODELS=ollama-cloud/gpt-oss:120b,ollama-cloud/glm-5
AITSEV_JUDGE_MODEL=ollama-cloud/gpt-oss:120b
AITSEV_FALLBACK_MODELS=ollama-cloud/gpt-oss:120b

# Optional extra providers (phase 2). Reference them as openai/<model> or anthropic/<model>.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# Local Ollama, referenced as ollama-local/<model>:
# AITSEV_OLLAMA_LOCAL_BASE_URL=http://localhost:11434

# ---- Accounts and public release (phase 5) ----
# Address users reach the server at; used in email links (verify, reset password).
AITSEV_PUBLIC_URL=http://localhost:8000
AITSEV_ALLOW_SIGNUP=true
# Default: required outside development.
# AITSEV_REQUIRE_EMAIL_VERIFICATION=true
AITSEV_SESSION_DAYS=30
# Default: Secure cookies (HTTPS only) outside development.
# AITSEV_COOKIE_SECURE=true
AITSEV_DEFAULT_PLAN=free
# Outgoing email. Without SMTP, emails are only written to the server log.
# AITSEV_SMTP_HOST=smtp.example.com
# AITSEV_SMTP_PORT=587
# AITSEV_SMTP_USERNAME=
# AITSEV_SMTP_PASSWORD=
# AITSEV_EMAIL_FROM=Aitsev <no-reply@example.com>
# Built web app (landing page at /, app at /app). Set automatically in the Docker image.
# AITSEV_WEB_DIST_DIR=../desktop/dist-web
# Where the website's Download buttons point (GitHub Releases of your repo).
# AITSEV_DOWNLOAD_BASE_URL=https://github.com/<owner>/<repo>/releases/latest/download
# Models users can choose (JSON); defaults in apps/backend/src/aitsev/catalog.py.
# Premium models (Claude, GPT) need ANTHROPIC_API_KEY / OPENAI_API_KEY above and a paid plan.
# AITSEV_MODEL_CATALOG=[{"id":"ollama-cloud/glm-5","label":"GLM-5"}]
