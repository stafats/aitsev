{
  "name": "aitsev",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "check": "pnpm -r run typecheck && pnpm -r run test && pnpm -r run build",
    "package:vscode": "pnpm --filter aitsev-vscode run package"
  }
}
